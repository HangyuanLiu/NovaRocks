{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "docker/iceberg-rest/up.sh --prepare-only 1>&2 || true",
            "timeout": 120,
            "statusMessage": "Preparing NovaRocks worktree environment..."
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "novarocks-dev-workflow": {
      "source": {
        "source": "directory",
        "path": "./.agents/skills/dev-workflow"
      }
    }
  },
  "enabledPlugins": {
    "dev-workflow@novarocks-dev-workflow": true
  }
}
