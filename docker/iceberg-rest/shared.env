# Shared Docker fixture defaults for docker/iceberg-rest.
#
# These ports intentionally use the services' conventional local defaults.
# Per-worktree NovaRocks standalone-server ports are allocated separately by
# up.sh, starting from NOVA_ENV_MYSQL_PORT_START.

NOVA_ENV_SHARED_DOCKER=true
NOVA_ENV_SHARED_COMPOSE_PROJECT=nr-iceberg-rest

# Benchmark fixture data is intentionally shared across worktrees. It is
# distinct from the per-worktree Iceberg warehouses generated by up.sh.
NOVA_ENV_SHARED_BENCHMARK_ROOT=s3://novarocks/shared/benchmarks

# The lease container coordinates one benchmark writer on this Docker host; it
# never owns fixture data. Pin the helper by immutable manifest digest.
NOVA_ENV_BENCHMARK_LEASE_IMAGE=docker.io/library/busybox@sha256:3c6ae8008e2c2eedd141725c30b20d9c36b026eb796688f88205845ef17aa213
NOVA_ENV_BENCHMARK_LEASE_HEARTBEAT_SECONDS=10
NOVA_ENV_BENCHMARK_LEASE_EXPIRY_SECONDS=45
NOVA_ENV_BENCHMARK_LEASE_WAIT_SECONDS=600
NOVA_ENV_BENCHMARK_BUILD_TIMEOUT_SECONDS=3600

NOVA_ENV_MINIO_PORT=9000
NOVA_ENV_MINIO_CONSOLE_PORT=9001
NOVA_ENV_REST_PORT=8181
NOVA_ENV_SPARK_UI_PORT=4040

NOVA_ENV_MYSQL_PORT_START=9030
NOVA_ENV_MYSQL_PORT_RANGE=200

NOVA_ENV_SHARED_REST_WAREHOUSE_URI=s3://warehouse/shared/rest
NOVA_ENV_REST_WAREHOUSE_URI=s3://warehouse/shared/rest

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123

ICEBERG_REST_IMAGE=apache/iceberg-rest-fixture:1.10.1
SPARK_ICEBERG_IMAGE=novarocks/spark-iceberg:3.5.5_1.11.0
NOVA_ENV_SPARK_VERSION=3.5.5-java17
NOVA_ENV_ICEBERG_VERSION=1.11.0

# Test-only CP-3D catalog protocol proxy. Ordinary suites keep the vanilla
# REST Catalog endpoint and must not advertise this production capability.
