+  @Test
+  public void storageTableParticipatesInVersionEquivalence() {
+    ViewVersion template = newViewVersion(1, "select 1 as count");
+    ViewVersion first =
+        ImmutableViewVersion.builder()
+            .from(template)
+            .storageTable(TableIdentifier.of("ns", "storage_one"))
+            .build();
+    ViewMetadata original =
+        ViewMetadata.builder()
+            .setLocation("location")
+            .addSchema(new Schema(Types.NestedField.required(1, "count", Types.LongType.get())))
+            .addVersion(first)
+            .setCurrentVersionId(1)
+            .build();
+    ViewVersion second =
+        ImmutableViewVersion.builder()
+            .from(first)
+            .storageTable(TableIdentifier.of("ns", "storage_two"))
+            .build();
+    ViewMetadata updated =
+        ViewMetadata.buildFrom(original)
+            .addVersion(second)
+            .setCurrentVersionId(-1)
+            .build();
+
+    assertThat(updated.currentVersionId()).isEqualTo(2);
+    assertThat(updated.versions()).hasSize(2);
+    assertThat(updated.version(1).storageTable()).isEqualTo(first.storageTable());
+    assertThat(updated.version(2).storageTable()).isEqualTo(second.storageTable());
+  }
