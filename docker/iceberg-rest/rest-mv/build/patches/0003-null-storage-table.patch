+package org.apache.iceberg.rest;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import jakarta.servlet.http.HttpServletRequest;
+import java.io.BufferedReader;
+import java.io.IOException;
+import java.io.StringReader;
+import java.util.Arrays;
+import org.junit.jupiter.api.Test;
+
+public class TestRESTCatalogServlet {
+  private HttpServletRequest request(String body) throws IOException {
+    HttpServletRequest request = mock(HttpServletRequest.class);
+    when(request.getMethod()).thenReturn("POST");
+    when(request.getRequestURI()).thenReturn("/v1/namespaces/ns/views");
+    when(request.getReader()).thenReturn(new BufferedReader(new StringReader(body)));
+    return request;
+  }
+
+  @Test
+  public void invalidStorageTableRequestIsBadRequest() throws IOException {
+    for (String pointer :
+        Arrays.asList("{\"namespace\":[]}", "{\"namespace\":\"ns\",\"name\":\"s\"}")) {
+      String body =
+          "{\"name\":\"view\",\"schema\":{\"type\":\"struct\",\"schema-id\":0,\"fields\":[]},"
+              + "\"view-version\":{\"version-id\":1,\"timestamp-ms\":1,\"schema-id\":0,"
+              + "\"summary\":{},\"representations\":[],\"default-namespace\":[],\"storage-table\":"
+              + pointer
+              + "},\"properties\":{}}";
+      RESTCatalogServlet.ServletRequestContext context =
+          RESTCatalogServlet.ServletRequestContext.from(request(body));
+      assertThat(context.error()).isPresent();
+      assertThat(context.error().get().code()).isEqualTo(400);
+    }
+  }
+
+  @Test
+  public void malformedJsonIsBadRequest() throws IOException {
+    RESTCatalogServlet.ServletRequestContext context =
+        RESTCatalogServlet.ServletRequestContext.from(request("{"));
+    assertThat(context.error()).isPresent();
+    assertThat(context.error().get().code()).isEqualTo(400);
+  }
+
+  @Test
+  public void readerFailureRemainsAnIOException() throws IOException {
+    HttpServletRequest request = request("{}");
+    when(request.getReader()).thenThrow(new IOException("read failed"));
+    assertThatThrownBy(() -> RESTCatalogServlet.ServletRequestContext.from(request))
+        .isInstanceOf(IOException.class);
+  }
+}
