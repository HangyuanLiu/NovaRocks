+  @Test
+  public void explicitNullStorageTableIsAnOrdinaryView() {
+    String json =
+        "{\"version-id\":1,\"timestamp-ms\":12345,\"schema-id\":1,"
+            + "\"summary\":{},\"default-namespace\":[],\"representations\":[],"
+            + "\"storage-table\":null}";
+    ViewVersion parsed = ViewVersionParser.fromJson(json);
+    assertThat(parsed.storageTable()).isNull();
+    assertThat(ViewVersionParser.toJson(parsed)).doesNotContain("storage-table");
+  }
+
+  @Test
+  public void invalidStorageTableShapeIsRejected() {
+    String prefix =
+        "{\"version-id\":1,\"timestamp-ms\":12345,\"schema-id\":1,"
+            + "\"summary\":{},\"default-namespace\":[],\"representations\":[],"
+            + "\"storage-table\":";
+    assertThatThrownBy(() -> ViewVersionParser.fromJson(prefix + "{\"namespace\":[]}}"))
+        .isInstanceOf(IllegalArgumentException.class);
+    assertThatThrownBy(
+            () -> ViewVersionParser.fromJson(prefix + "{\"namespace\":\"ns\",\"name\":\"s\"}}"))
+        .isInstanceOf(IllegalArgumentException.class);
+  }
