# Shared local Hive Metastore defaults for docker/iceberg-hive.
#
# This fixture is intentionally separate from docker/iceberg-rest. It joins the
# REST fixture's Docker network so HMS can reach the MinIO service at
# http://minio:9000, but it has its own Compose project and runtime entry.

NOVA_ENV_SHARED_DOCKER=true
NOVA_ENV_SHARED_HIVE_COMPOSE_PROJECT=nr-iceberg-hive
NOVA_ENV_REST_COMPOSE_PROJECT=nr-iceberg-rest
NOVA_ENV_REST_NETWORK=nr-iceberg-rest_iceberg_net

NOVA_ENV_HMS_PORT=9083
NOVA_ENV_HMS_PORT_START=9083
NOVA_ENV_HMS_PORT_RANGE=200
NOVA_ENV_SHARED_HMS_WAREHOUSE_URI=s3://warehouse/shared/hms

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123

HMS_IMAGE=novarocks/hive-metastore:4.0.0
