TOP-N (limit=100) [i_product_name ASC NULLS FIRST] stats={rows=10}
  TOP-N (limit=100, offset=0) [i_product_name ASC NULLS FIRST] stats={rows=10}
    HASH AGGREGATE (SINGLE, group by: [i_product_name]) stats={rows=10}
      PROJECT [i_product_name] stats={rows=31250}
        FILTER stats={rows=31250}
          predicate: __sq_0.item_cnt > 0
          HASH JOIN (BROADCAST, LEFT OUTER, eq: [i1.i_manufact = i_manufact]) stats={rows=62500}
            SCAN tpcds.item (alias=i1) stats={rows=25000}
                 TABLE: tpcds.item
                 columns: i_manufact, i_product_name, i_manufact_id
                 min-max stats
                 predicates: i_manufact_id BETWEEN 738 AND 738 + 40
            BROADCAST EXCHANGE stats={rows=10}
              PROJECT [item_cnt, i_manufact] stats={rows=10}
                PROJECT [count() AS item_cnt, item.i_manufact AS i_manufact] stats={rows=10}
                  HASH AGGREGATE (SINGLE, group by: [item.i_manufact]) stats={rows=10}
                    aggregations: count()
                    SCAN tpcds.item stats={rows=64454}
                         TABLE: tpcds.item
                         columns: i_manufact, i_category, i_size, i_color, i_units
                         min-max stats
                         predicates: item.i_category = 'Women' AND item.i_color = 'powder' OR item.i_color = 'khaki' AND item.i_units = 'Ounce' OR item.i_units = 'Oz' AND item.i_size = 'medium' OR item.i_size = 'extra large' OR item.i_category = 'Women' AND item.i_color = 'brown' OR item.i_color = 'honeydew' AND item.i_units = 'Bunch' OR item.i_units = 'Ton' AND item.i_size = 'N/A' OR item.i_size = 'small' OR item.i_category = 'Men' AND item.i_color = 'floral' OR item.i_color = 'deep' AND item.i_units = 'N/A' OR item.i_units = 'Dozen' AND item.i_size = 'petite' OR item.i_size = 'large' OR item.i_category = 'Men' AND item.i_color = 'light' OR item.i_color = 'cornflower' AND item.i_units = 'Box' OR item.i_units = 'Pound' AND item.i_size = 'medium' OR item.i_size = 'extra large' OR item.i_category = 'Women' AND item.i_color = 'midnight' OR item.i_color = 'snow' AND item.i_units = 'Pallet' OR item.i_units = 'Gross' AND item.i_size = 'medium' OR item.i_size = 'extra large' OR item.i_category = 'Women' AND item.i_color = 'cyan' OR item.i_color = 'papaya' AND item.i_units = 'Cup' OR item.i_units = 'Dram' AND item.i_size = 'N/A' OR item.i_size = 'small' OR item.i_category = 'Men' AND item.i_color = 'orange' OR item.i_color = 'frosted' AND item.i_units = 'Each' OR item.i_units = 'Tbl' AND item.i_size = 'petite' OR item.i_size = 'large' OR item.i_category = 'Men' AND item.i_color = 'forest' OR item.i_color = 'ghost' AND item.i_units = 'Lb' OR item.i_units = 'Bundle' AND item.i_size = 'medium' OR item.i_size = 'extra large'
