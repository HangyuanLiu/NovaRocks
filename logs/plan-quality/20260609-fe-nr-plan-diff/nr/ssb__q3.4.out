SORT BY [d_year ASC NULLS FIRST, lo_revenue DESC NULLS LAST] stats={rows=56}
  GATHER EXCHANGE stats={rows=56}
    PROJECT [c_city, s_city, d_year, sum(lo_revenue) AS lo_revenue] stats={rows=56}
      HASH AGGREGATE (GLOBAL, group by: [c_city, s_city, d_year]) stats={rows=56}
        aggregations: sum(lo_revenue)
        HASH EXCHANGE (source: ShuffleAgg, hash: [c38, c46, c22]) stats={rows=56}
          HASH AGGREGATE (LOCAL, group by: [c_city, s_city, d_year]) stats={rows=56}
            aggregations: sum(lo_revenue)
            HASH JOIN (BROADCAST, INNER, eq: [lo_orderdate = d_datekey]) stats={rows=1000000}
              build runtime filters:
              - filter_id = 2, build_expr = (d_datekey)
              HASH JOIN (BROADCAST, INNER, eq: [lo_custkey = c_custkey]) stats={rows=1000000}
                build runtime filters:
                - filter_id = 1, build_expr = (c_custkey)
                HASH JOIN (BROADCAST, INNER, eq: [lo_suppkey = s_suppkey]) stats={rows=1000000}
                  build runtime filters:
                  - filter_id = 0, build_expr = (s_suppkey)
                  SCAN ssb.lineorder stats={rows=1000000}
                       TABLE: ssb.lineorder
                       columns: lo_custkey, lo_suppkey, lo_orderdate, lo_revenue
                       min-max stats
                      probe runtime filters:
                      - filter_id = 0, probe_expr = (lo_suppkey)
                      - filter_id = 1, probe_expr = (lo_custkey)
                      - filter_id = 2, probe_expr = (lo_orderdate)
                  BROADCAST EXCHANGE stats={rows=21875}
                    SCAN ssb.supplier stats={rows=21875}
                         TABLE: ssb.supplier
                         columns: s_suppkey, s_city
                         min-max stats
                         predicates: s_city = 'UNITED KI1' OR s_city = 'UNITED KI5' AND s_city IN ('UNITED KI1', 'UNITED KI5')
                BROADCAST EXCHANGE stats={rows=21875}
                  SCAN ssb.customer stats={rows=21875}
                       TABLE: ssb.customer
                       columns: c_custkey, c_city
                       min-max stats
                       predicates: c_city = 'UNITED KI1' OR c_city = 'UNITED KI5' AND c_city IN ('UNITED KI1', 'UNITED KI5')
              BROADCAST EXCHANGE stats={rows=25000}
                SCAN ssb.dates stats={rows=25000}
                     TABLE: ssb.dates
                     columns: d_datekey, d_year, d_yearmonth
                     min-max stats
                     predicates: d_yearmonth = 'Dec1997'
