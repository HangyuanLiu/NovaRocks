-- query 9
Explain String
GATHER EXCHANGE stats={rows=250000000}
  PROJECT [l.k AS k, r.flag AS flag] stats={rows=250000000}
    HASH JOIN (BROADCAST, LEFT OUTER, eq: [l.k = r.k]) stats={rows=250000000}
      SCAN db_sqlt_daa0fb3549863650.oq12_stats_join_l (alias=l) stats={rows=100000}
           TABLE: db_sqlt_daa0fb3549863650.oq12_stats_join_l
           columns: k
           min-max stats
      GATHER EXCHANGE stats={rows=100000}
        SCAN db_sqlt_daa0fb3549863650.oq12_stats_join_r (alias=r) stats={rows=100000}
             TABLE: db_sqlt_daa0fb3549863650.oq12_stats_join_r
             columns: k, flag
             min-max stats

-- query 10
Explain String
GATHER EXCHANGE stats={rows=25000}
  PROJECT [l.k AS k] stats={rows=25000}
    HASH JOIN (BROADCAST, LEFT SEMI, eq: [l.k = r.k]) stats={rows=25000}
      build runtime filters:
      - filter_id = 0, build_expr = (r.k)
      SCAN db_sqlt_daa0fb3549863650.oq12_stats_join_l (alias=l) stats={rows=100000}
           TABLE: db_sqlt_daa0fb3549863650.oq12_stats_join_l
           columns: k
           min-max stats
          probe runtime filters:
          - filter_id = 0, probe_expr = (l.k)
      GATHER EXCHANGE stats={rows=90000}
        SCAN db_sqlt_daa0fb3549863650.oq12_stats_join_r (alias=r) stats={rows=90000}
             TABLE: db_sqlt_daa0fb3549863650.oq12_stats_join_r
             columns: k
             min-max stats
             predicates: r.k IS NOT NULL

