-- query 9
Explain String
GATHER EXCHANGE stats={rows=100000}
  PROJECT [l.k AS k, r.flag AS flag] stats={rows=100000}
    HASH JOIN (PARTITIONED, LEFT OUTER, eq: [l.k = r.k]) stats={rows=100000}
      HASH EXCHANGE (source: ShuffleJoin, hash: [c1]) stats={rows=100000}
        SCAN db_sqlt_daa0fb3549863650.oq12_stats_join_l (alias=l) stats={rows=100000}
             TABLE: db_sqlt_daa0fb3549863650.oq12_stats_join_l
             columns: k
             min-max stats
      HASH EXCHANGE (source: ShuffleJoin, hash: [c3]) stats={rows=100000}
        SCAN db_sqlt_daa0fb3549863650.oq12_stats_join_r (alias=r) stats={rows=100000}
             TABLE: db_sqlt_daa0fb3549863650.oq12_stats_join_r
             columns: k, flag
             min-max stats

