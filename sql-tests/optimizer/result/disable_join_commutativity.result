-- query 9
Explain String
GATHER EXCHANGE stats={rows=2}
  PROJECT [lo.lo_orderkey AS lo_orderkey, d.d_year AS d_year] stats={rows=2}
    HASH JOIN (BROADCAST, RIGHT OUTER, eq: [lo.lo_datekey = d.d_datekey]) stats={rows=2}
      build runtime filters:
      - filter_id = 0, build_expr = (d.d_datekey)
      SCAN db_sqlt_113e43a4caf4f95c.lineorder (alias=lo) stats={rows=2}
           TABLE: db_sqlt_113e43a4caf4f95c.lineorder
           columns: lo_orderkey, lo_datekey
           min-max stats
          probe runtime filters:
          - filter_id = 0, probe_expr = (lo.lo_datekey)
      BROADCAST EXCHANGE stats={rows=2}
        SCAN db_sqlt_113e43a4caf4f95c.date_dim (alias=d) stats={rows=2}
             TABLE: db_sqlt_113e43a4caf4f95c.date_dim
             columns: d_datekey, d_year
             min-max stats

-- query 11
Explain String
GATHER EXCHANGE stats={rows=2}
  PROJECT [lo.lo_orderkey AS lo_orderkey, d.d_year AS d_year] stats={rows=2}
    HASH JOIN (BROADCAST, LEFT OUTER, eq: [d.d_datekey = lo.lo_datekey]) stats={rows=2}
      SCAN db_sqlt_113e43a4caf4f95c.date_dim (alias=d) stats={rows=2}
           TABLE: db_sqlt_113e43a4caf4f95c.date_dim
           columns: d_datekey, d_year
           min-max stats
      BROADCAST EXCHANGE stats={rows=2}
        SCAN db_sqlt_113e43a4caf4f95c.lineorder (alias=lo) stats={rows=2}
             TABLE: db_sqlt_113e43a4caf4f95c.lineorder
             columns: lo_orderkey, lo_datekey
             min-max stats
