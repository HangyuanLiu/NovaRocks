-- query 1
Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
11:PROJECT [count(*) AS cnt] stats={rows=1}
  10:HASH AGGREGATE (GLOBAL) stats={rows=1}
    aggregations: count()
    9:GATHER stats={rows=1}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 9
    PARTITION: UNPARTITIONED
8:HASH AGGREGATE (LOCAL) stats={rows=1}
  aggregations: count()
  7:HASH JOIN (PARTITIONED, INNER, eq: [p.k = b.k]) stats={rows=8333333}
    3:HASH EXCHANGE stats={rows=120000000}
    6:HASH EXCHANGE stats={rows=12000000}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 6
    PARTITION: HASH_PARTITIONED (k)
5:GENERATE_SERIES(1, 12000000, 1) stats={rows=12000000}
PLAN FRAGMENT 3
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 3
    PARTITION: HASH_PARTITIONED (k)
2:GENERATE_SERIES(1, 120000000, 1) stats={rows=120000000}

-- query 2
Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
10:PROJECT [count(*) AS cnt] stats={rows=1}
  9:HASH AGGREGATE (GLOBAL) stats={rows=1}
    aggregations: count()
    8:GATHER stats={rows=1}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 8
    PARTITION: UNPARTITIONED
7:HASH AGGREGATE (LOCAL) stats={rows=1}
  aggregations: count()
  6:HASH JOIN (BROADCAST, INNER, eq: [p.k = b.k]) stats={rows=10000}
    build runtime filters:
    - filter_id = 0, build_expr = (b.k)
    2:GENERATE_SERIES(1, 6000000, 1) stats={rows=6000000}
    5:GATHER stats={rows=10000}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 5
    PARTITION: UNPARTITIONED
4:GENERATE_SERIES(1, 10000, 1) stats={rows=10000}
