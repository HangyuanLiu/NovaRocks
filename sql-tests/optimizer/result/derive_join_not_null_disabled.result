-- query 7
Explain String
GATHER EXCHANGE stats={rows=810000000}
  PROJECT [l.v AS v, r.v AS v] stats={rows=810000000}
    HASH JOIN (BROADCAST, INNER, eq: [l.k = r.k]) stats={rows=810000000}
      build runtime filters:
      - filter_id = 0, build_expr = (r.k)
      SCAN db_sqlt_6bef84b7f7bb0b5f.t_dnn_dl (alias=l) stats={rows=90000}
           TABLE: db_sqlt_6bef84b7f7bb0b5f.t_dnn_dl
           columns: k, v
           min-max stats
           predicates: l.k IS NOT NULL
          probe runtime filters:
          - filter_id = 0, probe_expr = (l.k)
      GATHER EXCHANGE stats={rows=90000}
        SCAN db_sqlt_6bef84b7f7bb0b5f.t_dnn_dr (alias=r) stats={rows=90000}
             TABLE: db_sqlt_6bef84b7f7bb0b5f.t_dnn_dr
             columns: k, v
             min-max stats
             predicates: r.k IS NOT NULL

