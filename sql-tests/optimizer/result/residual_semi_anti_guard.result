-- query 5
Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
6:PROJECT [l.k AS k] stats={rows=17678}
  5:HASH JOIN (PARTITIONED, LEFT SEMI, eq: [l.k = r.k, l.flag = r.flag]) stats={rows=17678}
    other: l.flag = 1
    2:HASH EXCHANGE stats={rows=100000}
    4:HASH EXCHANGE stats={rows=81000}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 4
    PARTITION: HASH_PARTITIONED (k, flag)
3:SCAN db_sqlt_30e12a0be90ceeef.residual_sa_r (alias=r) stats={rows=81000}
     TABLE: db_sqlt_30e12a0be90ceeef.residual_sa_r
     columns: k, flag
     min-max stats
     predicates: r.k IS NOT NULL AND r.flag IS NOT NULL
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 2
    PARTITION: HASH_PARTITIONED (k, flag)
1:SCAN db_sqlt_30e12a0be90ceeef.residual_sa_l (alias=l) stats={rows=100000}
     TABLE: db_sqlt_30e12a0be90ceeef.residual_sa_l
     columns: k, flag
     min-max stats

