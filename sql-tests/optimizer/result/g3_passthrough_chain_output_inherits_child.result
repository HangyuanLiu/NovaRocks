  runtime filter channel 0
    producer binding 0, fragment = 1, node = 4, expr = (a.k)
    consumer binding 1, fragment = 1, node = 1, expr = (b.k), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
8:PROJECT [a.k AS k, sum(a.v + b.w) AS s] stats={rows=2}
  7:HASH AGGREGATE (GLOBAL, group by: [a.k]) stats={rows=2}
    aggregations: sum(a.v + b.w)
    6:HASH EXCHANGE stats={rows=2}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 6
    PARTITION: HASH_PARTITIONED (k)
5:HASH AGGREGATE (LOCAL, group by: [a.k]) stats={rows=2}
  aggregations: sum(a.v + b.w)
  4:HASH JOIN (BROADCAST, INNER, eq: [b.k = a.k]) bcast_verdict=feasible stats={rows=2}
