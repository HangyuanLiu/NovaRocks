-- query 5
Explain String
GATHER EXCHANGE stats={rows=50625000}
  PROJECT [l.lk AS lk, r.rk AS rk] stats={rows=50625000}
    HASH JOIN (BROADCAST, INNER, eq: [r.rk = l.lk]) stats={rows=50625000}
      build runtime filters:
      - filter_id = 0, build_expr = (l.lk)
      SCAN db_sqlt_78546de01468a3d3.g7_r (alias=r) stats={rows=90000}
           TABLE: db_sqlt_78546de01468a3d3.g7_r
           columns: rk
           min-max stats
           predicates: r.rk IS NOT NULL
          probe runtime filters:
          - filter_id = 0, probe_expr = (r.rk)
      GATHER EXCHANGE stats={rows=22500}
        SCAN db_sqlt_78546de01468a3d3.g7_l (alias=l) stats={rows=22500}
             TABLE: db_sqlt_78546de01468a3d3.g7_l
             columns: lk
             min-max stats
             predicates: l.lk = 10 AND l.lk IS NOT NULL

