Explain String
GATHER EXCHANGE stats={rows=2}
  PROJECT [a.k AS k, a.v AS v, b.w AS w, rn] stats={rows=2}
    WINDOW [row_number()] stats={rows=2}
      SORT BY [a.k ASC NULLS FIRST, a.v ASC NULLS FIRST] stats={rows=2}
        HASH EXCHANGE (source: ShuffleAgg, hash: [c1]) stats={rows=2}
          HASH JOIN (BROADCAST, INNER, eq: [a.k = s.s]) stats={rows=2}
            build runtime filters:
            - filter_id = 1, build_expr = (s.s)
            HASH JOIN (BROADCAST, INNER, eq: [a.k = b.k]) stats={rows=2}
              build runtime filters:
              - filter_id = 0, build_expr = (b.k)
              SCAN db_sqlt_fc3e81882b2a0111.g3_bj_left (alias=a) stats={rows=2}
                   TABLE: db_sqlt_fc3e81882b2a0111.g3_bj_left
                   columns: k, v
                   min-max stats
                   predicates: a.k IS NOT NULL
                  probe runtime filters:
                  - filter_id = 0, probe_expr = (a.k)
                  - filter_id = 1, probe_expr = (a.k)
              BROADCAST EXCHANGE stats={rows=2}
                SCAN db_sqlt_fc3e81882b2a0111.g3_bj_right (alias=b) stats={rows=2}
                     TABLE: db_sqlt_fc3e81882b2a0111.g3_bj_right
                     columns: k, w
                     min-max stats
                     predicates: b.k IS NOT NULL
            BROADCAST EXCHANGE stats={rows=1}
              SCAN db_sqlt_fc3e81882b2a0111.g3_bj_small (alias=s) stats={rows=1}
                   TABLE: db_sqlt_fc3e81882b2a0111.g3_bj_small
                   columns: s, x
                   min-max stats
                   predicates: s.s IS NOT NULL
