-- query 4
Explain String
GATHER EXCHANGE stats={rows=50000}
  PROJECT [s.k AS k] stats={rows=50000}
    PROJECT [k] stats={rows=50000}
      PROJECT [k] stats={rows=50000}
        SCAN db_sqlt_73474ac5ba7b3917.oq6_alias_base stats={rows=50000}
             TABLE: db_sqlt_73474ac5ba7b3917.oq6_alias_base
             columns: k, v
             min-max stats
             predicates: v > 10

-- query 5
Explain String
SORT BY [renamed_k ASC NULLS FIRST] stats={rows=100000}
  GATHER EXCHANGE stats={rows=100000}
    PROJECT [renamed_k] stats={rows=100000}
      PROJECT [k AS renamed_k] stats={rows=100000}
        PROJECT [k] stats={rows=100000}
          SCAN db_sqlt_73474ac5ba7b3917.oq6_alias_base stats={rows=100000}
               TABLE: db_sqlt_73474ac5ba7b3917.oq6_alias_base
               columns: k
               min-max stats

