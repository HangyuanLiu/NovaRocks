-- query 7
Explain String
PROJECT [count() AS count(*)] stats={rows=1}
  HASH AGGREGATE (GLOBAL) stats={rows=1}
    aggregations: count()
    GATHER EXCHANGE stats={rows=1}
      HASH AGGREGATE (LOCAL) stats={rows=1}
        aggregations: count()
        HASH JOIN (PARTITIONED, INNER, eq: [w_alias.k = b.k]) stats={rows=90000}
          HASH EXCHANGE (source: ShuffleJoin, hash: [c5]) stats={rows=45000}
            FILTER stats={rows=45000}
              predicate: w_alias.k IS NOT NULL
              PROJECT [k, v] stats={rows=50000}
                PROJECT [k, v] stats={rows=50000}
                  SCAN db_sqlt_73474ac5ba7b3917.oq6_alias_base stats={rows=50000}
                       TABLE: db_sqlt_73474ac5ba7b3917.oq6_alias_base
                       columns: k, v
                       min-max stats
                       predicates: k < 3
          HASH EXCHANGE (source: ShuffleJoin, hash: [c3]) stats={rows=90000}
            SCAN db_sqlt_73474ac5ba7b3917.oq6_alias_base (alias=b) stats={rows=90000}
                 TABLE: db_sqlt_73474ac5ba7b3917.oq6_alias_base
                 columns: k
                 min-max stats
                 predicates: b.k IS NOT NULL
