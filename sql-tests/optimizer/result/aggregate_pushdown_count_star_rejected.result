    aggregations: count()
    GATHER EXCHANGE stats={rows=1}
      HASH AGGREGATE (LOCAL) stats={rows=1}
        aggregations: count()
        HASH JOIN (BROADCAST, INNER, eq: [a.k = b.k]) stats={rows=810000000}
          SCAN db_sqlt_f6521d6ed49857d9.t_agg_pd_neg_a (alias=a) stats={rows=90000}
               TABLE: db_sqlt_f6521d6ed49857d9.t_agg_pd_neg_a
               columns: k
               min-max stats
               predicates: a.k IS NOT NULL
          GATHER EXCHANGE stats={rows=90000}
