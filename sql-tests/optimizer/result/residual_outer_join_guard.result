Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
6:PROJECT [l.k AS k, r.k AS k] stats={rows=1250000000}
  5:HASH JOIN (PARTITIONED, RIGHT OUTER, eq: [r.k = l.k]) stats={rows=1250000000}
    other: l.flag = 1
    2:HASH EXCHANGE stats={rows=100000}
    4:HASH EXCHANGE stats={rows=100000}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 4
    PARTITION: HASH_PARTITIONED (k)
3:SCAN db_sqlt_bff9997550cead6c.residual_outer_l (alias=l) stats={rows=100000}
     TABLE: db_sqlt_bff9997550cead6c.residual_outer_l
     columns: k, flag
     min-max stats
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 2
    PARTITION: HASH_PARTITIONED (k)
1:SCAN db_sqlt_bff9997550cead6c.residual_outer_r (alias=r) stats={rows=100000}
     TABLE: db_sqlt_bff9997550cead6c.residual_outer_r
     columns: k
     min-max stats
