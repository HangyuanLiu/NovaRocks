-- query 15
Explain String
PROJECT [count(*) AS cnt] stats={rows=1}
  HASH AGGREGATE (GLOBAL) stats={rows=1}
    aggregations: count()
    GATHER EXCHANGE stats={rows=1}
      HASH AGGREGATE (LOCAL) stats={rows=1}
        aggregations: count()
        HASH JOIN (BROADCAST, INNER, eq: [t1.av = t2.cv]) stats={rows=2}
          build runtime filters:
          - filter_id = 2, build_expr = (t2.cv)
          PROJECT [av] stats={rows=2}
            PROJECT [a.v AS av] stats={rows=2}
              HASH JOIN (BROADCAST, INNER, eq: [b.k = a.k]) stats={rows=2}
                build runtime filters:
                - filter_id = 0, build_expr = (a.k)
                SCAN db_sqlt_c6f027b326bfa589.customer_demographics (alias=b) stats={rows=3}
                     TABLE: db_sqlt_c6f027b326bfa589.customer_demographics
                     columns: k
                     min-max stats
                     predicates: b.k IS NOT NULL
                    probe runtime filters:
                    - filter_id = 0, probe_expr = (b.k)
                BROADCAST EXCHANGE stats={rows=2}
                  SCAN db_sqlt_c6f027b326bfa589.ra (alias=a) stats={rows=2}
                       TABLE: db_sqlt_c6f027b326bfa589.ra
                       columns: k, v
                       min-max stats
                       predicates: a.k IS NOT NULL AND a.v IS NOT NULL
          BROADCAST EXCHANGE stats={rows=2}
            PROJECT [cv] stats={rows=2}
              PROJECT [c.v AS cv] stats={rows=2}
                HASH JOIN (BROADCAST, INNER, eq: [d.k = c.k]) stats={rows=2}
                  build runtime filters:
                  - filter_id = 1, build_expr = (c.k)
                  SCAN db_sqlt_c6f027b326bfa589.customer_demographics (alias=d) stats={rows=3}
                       TABLE: db_sqlt_c6f027b326bfa589.customer_demographics
                       columns: k
                       min-max stats
                       predicates: d.k IS NOT NULL
                      probe runtime filters:
                      - filter_id = 1, probe_expr = (d.k)
                  BROADCAST EXCHANGE stats={rows=2}
                    SCAN db_sqlt_c6f027b326bfa589.ra (alias=c) stats={rows=2}
                         TABLE: db_sqlt_c6f027b326bfa589.ra
                         columns: k, v
                         min-max stats
                         predicates: c.k IS NOT NULL AND c.v IS NOT NULL

-- query 16
Explain String
PROJECT [count(*) AS cnt] stats={rows=1}
  HASH AGGREGATE (GLOBAL) stats={rows=1}
    aggregations: count()
    GATHER EXCHANGE stats={rows=1}
      HASH AGGREGATE (LOCAL) stats={rows=1}
        aggregations: count()
        HASH JOIN (BROADCAST, INNER, eq: [p.k = b.k]) stats={rows=3}
          build runtime filters:
          - filter_id = 0, build_expr = (b.k)
          SCAN db_sqlt_c6f027b326bfa589.rf_x_probe (alias=p) stats={rows=90000}
               TABLE: db_sqlt_c6f027b326bfa589.rf_x_probe
               columns: k
               min-max stats
               predicates: p.k IS NOT NULL
              probe runtime filters:
              - filter_id = 0, probe_expr = (p.k)
          BROADCAST EXCHANGE stats={rows=3}
            SCAN db_sqlt_c6f027b326bfa589.rf_x_build (alias=b) stats={rows=3}
                 TABLE: db_sqlt_c6f027b326bfa589.rf_x_build
                 columns: k
                 min-max stats
                 predicates: b.k IS NOT NULL
