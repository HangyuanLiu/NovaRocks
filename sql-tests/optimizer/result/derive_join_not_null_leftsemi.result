GATHER EXCHANGE stats={rows=25000}
  PROJECT [l.v AS v] stats={rows=25000}
    HASH JOIN (BROADCAST, LEFT SEMI, eq: [l.k = r.k]) stats={rows=25000}
      build runtime filters:
      - filter_id = 0, build_expr = (r.k)
      SCAN db_sqlt_7cd7263e7b7b29cb.t_dnn_sl (alias=l) stats={rows=100000}
           TABLE: db_sqlt_7cd7263e7b7b29cb.t_dnn_sl
           columns: k, v
           min-max stats
          probe runtime filters:
          - filter_id = 0, probe_expr = (l.k)
      GATHER EXCHANGE stats={rows=90000}
        SCAN db_sqlt_7cd7263e7b7b29cb.t_dnn_sr (alias=r) stats={rows=90000}
             TABLE: db_sqlt_7cd7263e7b7b29cb.t_dnn_sr
             columns: k
