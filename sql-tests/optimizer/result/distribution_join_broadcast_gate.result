PROJECT [count(*) AS cnt] stats={rows=1}
  HASH AGGREGATE (GLOBAL) stats={rows=1}
    aggregations: count()
    GATHER EXCHANGE stats={rows=1}
      HASH AGGREGATE (LOCAL) stats={rows=1}
        aggregations: count()
        HASH JOIN (BROADCAST, INNER, eq: [p.k = b.k]) stats={rows=900}
          build runtime filters:
          - filter_id = 0, build_expr = (b.k)
          SCAN db_sqlt_799798d82c18b203.oq8_probe_big (alias=p) stats={rows=900}
               TABLE: db_sqlt_799798d82c18b203.oq8_probe_big
               columns: k
               min-max stats
               predicates: p.k IS NOT NULL
              probe runtime filters:
              - filter_id = 0, probe_expr = (p.k)
          BROADCAST EXCHANGE stats={rows=900}
            SCAN db_sqlt_799798d82c18b203.oq8_build_big (alias=b) stats={rows=900}
