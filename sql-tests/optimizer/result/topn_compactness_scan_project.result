-- query 4
Explain String
TOP-N (limit=2) [alias_score DESC NULLS LAST, alias_id ASC NULLS FIRST] stats={rows=2}
  PROJECT [alias_id, alias_score] stats={rows=2}
    PROJECT [alias_id, alias_score] stats={rows=2}
      PROJECT [id AS alias_id, score AS alias_score] stats={rows=2}
        TOP-N (limit=2, offset=0) [score DESC NULLS LAST, id ASC NULLS FIRST] stats={rows=2}
          SCAN db_sqlt_d8fea78b81ecf9eb.topn_compactness_project_src stats={rows=3}
               TABLE: db_sqlt_d8fea78b81ecf9eb.topn_compactness_project_src
               columns: id, score
               min-max stats

