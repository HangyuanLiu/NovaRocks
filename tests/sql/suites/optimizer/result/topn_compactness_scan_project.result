-- query 4
Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
6:PROJECT [alias_id, alias_score] stats={rows=2}
  5:PROJECT [alias_id, alias_score] stats={rows=2}
    4:MERGING-EXCHANGE stats={rows=2}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 4
    PARTITION: UNPARTITIONED
3:LOCAL TOP-N (limit=2, offset=0) [alias_score DESC NULLS LAST, alias_id ASC NULLS FIRST] stats={rows=2}
  2:PROJECT [id AS alias_id, score AS alias_score] stats={rows=3}
    1:SCAN db_sqlt_d8fea78b81ecf9eb.topn_compactness_project_src stats={rows=3}
         TABLE: db_sqlt_d8fea78b81ecf9eb.topn_compactness_project_src
         columns: id, score
         min-max stats

-- query 6
Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
6:MERGING-EXCHANGE stats={rows=2}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 6
    PARTITION: UNPARTITIONED
5:LOCAL TOP-N (limit=2, offset=0) [alias_score DESC NULLS LAST, alias_id ASC NULLS FIRST] stats={rows=2}
  4:PROJECT [alias_id, alias_score] stats={rows=3}
    3:PROJECT [alias_id, alias_score] stats={rows=3}
      2:PROJECT [id AS alias_id, score AS alias_score] stats={rows=3}
        1:SCAN db_sqlt_d8fea78b81ecf9eb.topn_compactness_project_src stats={rows=3}
             TABLE: db_sqlt_d8fea78b81ecf9eb.topn_compactness_project_src
             columns: id, score
             min-max stats
