-- query 10
Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
0:GATHER stats={rows=160}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  PARTITION: HASH_PARTITIONED (k)
  STREAM DATA SINK
    EXCHANGE ID: 0
    PARTITION: UNPARTITIONED
1:HASH AGGREGATE (DISTINCT_GLOBAL, group by: [k]) stats={rows=160}
  2:HASH EXCHANGE stats={rows=160}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 2
    PARTITION: HASH_PARTITIONED (k)
3:HASH AGGREGATE (LOCAL, group by: [k]) stats={rows=160}
  4:UNION ALL stats={rows=1600}
    5:PROJECT [k] stats={rows=1000}
      6:SCAN db_sqlt_3f2ae48f6df098ce.oq12_stats_set_l stats={rows=1000}
           TABLE: db_sqlt_3f2ae48f6df098ce.oq12_stats_set_l
           columns: k
           min-max stats
    7:PROJECT [k] stats={rows=600}
      8:SCAN db_sqlt_3f2ae48f6df098ce.oq12_stats_set_r stats={rows=600}
           TABLE: db_sqlt_3f2ae48f6df098ce.oq12_stats_set_r
           columns: k
           min-max stats

