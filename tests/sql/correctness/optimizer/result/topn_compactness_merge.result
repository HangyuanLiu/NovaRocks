-- query 2
Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
0:PROJECT [id, score] stats={rows=2}
  1:PROJECT [id, score] stats={rows=2}
    2:PROJECT [id, score] stats={rows=2}
      3:PROJECT [id, score] stats={rows=2}
        4:TOP-N (limit=2) [score DESC NULLS LAST, id ASC NULLS FIRST] stats={rows=2}
          5:GATHER stats={rows=4}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 5
    PARTITION: UNPARTITIONED
6:UNION ALL stats={rows=4}
  7:UNION ALL stats={rows=3}
    8:UNION ALL stats={rows=2}
      9:PROJECT [1 AS id, 10 AS score] stats={rows=1}
        10:VALUES (1 rows) stats={rows=1}
      11:PROJECT [2 AS id, 20 AS score] stats={rows=1}
        12:VALUES (1 rows) stats={rows=1}
    13:PROJECT [3 AS id, 20 AS score] stats={rows=1}
      14:VALUES (1 rows) stats={rows=1}
  15:PROJECT [4 AS id, 5 AS score] stats={rows=1}
    16:VALUES (1 rows) stats={rows=1}

-- query 4
Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
0:TOP-N (limit=2) [score DESC NULLS LAST, id ASC NULLS FIRST] stats={rows=2}
  1:PROJECT [id, score] stats={rows=3}
    2:PROJECT [id, score] stats={rows=3}
      3:TOP-N (limit=3) [score DESC NULLS LAST, id ASC NULLS FIRST] stats={rows=3}
        4:GATHER stats={rows=4}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
