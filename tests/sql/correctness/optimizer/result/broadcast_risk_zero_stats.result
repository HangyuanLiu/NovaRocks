Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
0:PROJECT [count(*)] stats={rows=1}
  1:HASH AGGREGATE (GLOBAL) stats={rows=1}
    aggregations: count(*)
    2:GATHER stats={rows=1}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 2
    PARTITION: UNPARTITIONED
3:HASH AGGREGATE (LOCAL) stats={rows=1}
  aggregations: count()
  4:HASH JOIN (PARTITIONED, INNER, eq: [k = k]) stats={rows=11250000000000}
    5:HASH EXCHANGE
    6:HASH EXCHANGE
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 5
    PARTITION: HASH_PARTITIONED (k)
7:PROJECT [generate_series] stats={rows=1000000}
  8:PROJECT [generate_series] stats={rows=1000000}
    9:GENERATE_SERIES(1, 1000000, 1) stats={rows=1000000}
PLAN FRAGMENT 3
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 6
    PARTITION: HASH_PARTITIONED (k)
10:FILTER stats={rows=45000000}
  predicate: k IS NOT NULL
  11:PROJECT [k] stats={rows=50000000}
    12:PROJECT [k] stats={rows=50000000}
      13:PROJECT [k] stats={rows=50000000}
        14:FILTER stats={rows=50000000}
          predicate: k > 0
          15:PROJECT [generate_series + 0 AS k] stats={rows=100000000}
            16:GENERATE_SERIES(1, 100000000, 1) stats={rows=100000000}
