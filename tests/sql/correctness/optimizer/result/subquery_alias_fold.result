Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 1, node = 4, expr = (k)
    consumer binding 1, fragment = 1, node = 5, expr = (b.k), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
0:PROJECT [count(*)] stats={rows=1}
  1:HASH AGGREGATE (GLOBAL) stats={rows=1}
    aggregations: count(*)
    2:GATHER stats={rows=1}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 2
    PARTITION: UNPARTITIONED
