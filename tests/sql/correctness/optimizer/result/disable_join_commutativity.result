-- query 10
Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 1, node = 2, expr = (d.d_datekey)
    consumer binding 1, fragment = 1, node = 3, expr = (lo.lo_datekey), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
0:GATHER stats={rows=16200}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 0
    PARTITION: UNPARTITIONED
1:PROJECT [lo.lo_orderkey, d.d_year] stats={rows=16200}
  2:HASH JOIN (BROADCAST, INNER, eq: [lo.lo_datekey = d.d_datekey]) bcast_verdict=feasible stats={rows=16200}
