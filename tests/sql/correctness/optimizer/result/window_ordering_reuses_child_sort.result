Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
0:PROJECT [running_sum] stats={rows=3}
  1:WINDOW [sum(v)] stats={rows=3}
    order by: [id ASC NULLS FIRST]
    2:PROJECT [id, v] stats={rows=3}
      3:SORT BY [id ASC NULLS FIRST] stats={rows=3}
        4:GATHER stats={rows=3}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 4
    PARTITION: UNPARTITIONED
5:PROJECT [id, v] stats={rows=3}
  6:PROJECT [id, v] stats={rows=3}
    7:UNION ALL stats={rows=3}
      8:UNION ALL stats={rows=2}
