-- query 4
Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
0:PROJECT [id, score] stats={rows=2}
  1:PROJECT [id, score] stats={rows=2}
    2:TOP-N (limit=2, offset=0) [score DESC NULLS LAST, id ASC NULLS FIRST] stats={rows=2}
      3:GATHER
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 3
    PARTITION: UNPARTITIONED
4:LOCAL TOP-N (limit=2, offset=0) [score DESC NULLS LAST, id ASC NULLS FIRST] stats={rows=2}
  5:PROJECT [id, score] stats={rows=3}
    6:SCAN db_sqlt_d8fea78b81ecf9eb.topn_compactness_project_src stats={rows=3}
         TABLE: db_sqlt_d8fea78b81ecf9eb.topn_compactness_project_src
         columns: id, score
         min-max stats

-- query 6
Explain String
