  "native_topology": "1FE+3BE cross-process, serial jobs=1",
  "scope": "M07 P09 functional regression repairs and preserved baseline/fixture limitations; no release performance or same-HEAD full-CI claim.",
  "fixes": [
    {
      "revision": "de0064efc4e6c9e8162cd688f10fbe4d2d53b0fc",
      "behavior": "Planning uses the existing 16 MiB CPU worker stack; recursive CTE planning survives the production executor."
    },
    {
      "revision": "c25303d7ad3c2a0e2794e494771f4fd2bb69dd5d",
      "behavior": "Foreground MV refresh admits Internal result capacity while retaining its Management work class."
    },
    {
      "revision": "3ef0f7f1507f060c55f3849f86ff80c091cb0322",
      "behavior": "Runtime-filter assertions name actual qualified partition keys and both bilateral probe channels."
    },
    {
      "revision": "a6599a95c1314e03723b98ca9866046da6102cca",
      "behavior": "MV repartition admits Internal result capacity; non-writing MV alterations retain Local capacity."
    },
    {
      "revision": "e6c686ff07c97d56c899cc1208aae1a0b6ae36ea",
      "behavior": "Root read waits floor to whole milliseconds within the original absolute deadline; submillisecond remainder expires without an RPC."
    },
    {
      "revision": "3c22d3e219c133d44b65653e909f7e8f24cc84b2",
      "behavior": "Scalar overflow exposes a finite static 64 KiB record refusal; typed first-party renderer diagnostics retain the output ordinal."
    },
    {
      "revision": "e219356973a2596925d7b534d363393d571eb3cc",
      "behavior": "Client renderer failures expose finite static reasons without copying SDK or user payloads."
    },
    {
      "revision": "17b145e83f77505345cd9d1b473386f69d0a4830",
      "behavior": "Common Decimal/integer precision covers both ranges, including Decimal256 promotion; strict renderer validation stays enabled."
    },
    {
      "revision": "dae50b53e888ff146d18f486b236def189a7b808",
      "behavior": "The original 10,000-row oversized Scalar assignment is refused atomically and preserves the admitted ten-element session value."
    },
    {
      "revision": "782fe28589a205cb309424a1b77bc87d9548e911",
      "behavior": "SQL runner explicitly supports the existing performance launch profile for release servers and refuses fault directives; default is unchanged."
    },
    {
      "revision": "2494960e46984e13c642a82b62d1ca83c09de080",
      "behavior": "JOIN golden preserves the widened 1000 key; an explicit Decimal(3,0) narrowing retains overflow-mode coverage."
    }
  ],
