[package]
name = "m07-original-task-cell-feature-probe"
version = "0.0.0"
edition = "2021"

[[test]]
name = "features"
path = "features.rs"

[features]
default = []
owner = ["tokio/io-util"]
multi = ["tokio/rt-multi-thread"]
trace = ["tokio/tracing"]

[dependencies]
tokio = { path = "__REPO__/vendor/tokio-1.52.3", default-features = false, features = ["rt"] }
bytes = { path = "__REPO__/vendor/bytes-1.11.0" }

[workspace]

[patch.crates-io]
tokio = { path = "__REPO__/vendor/tokio-1.52.3" }
bytes = { path = "__REPO__/vendor/bytes-1.11.0" }

[lints.rust]
unexpected_cfgs = { level = "warn", check-cfg = ['cfg(tokio_unstable)'] }
