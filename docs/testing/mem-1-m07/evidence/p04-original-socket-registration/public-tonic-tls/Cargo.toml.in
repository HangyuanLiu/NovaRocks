[package]
name = "m07-tonic-attempt-tls-public-parity"
version = "0.0.0"
edition = "2021"

[[test]]
name = "parity"
path = "parity.rs"

[dependencies]
tonic = { path = "__REPO__/vendor/tonic-0.12.3", default-features = false, features = ["transport", "tls"] }
tokio = { version = "=1.52.3", features = ["rt", "io-util"] }
hyper-util = { version = "0.1.4", features = ["tokio"] }
http = "1"
h2 = "0.4"
bytes = "1.0"
tower = { version = "0.4.7", features = ["util"] }

[workspace]

[patch.crates-io]
bytes = { path = "__REPO__/vendor/bytes-1.11.0" }
http = { path = "__REPO__/vendor/http-1.4.0" }
h2 = { path = "__REPO__/vendor/h2-0.4.12" }
hyper = { path = "__REPO__/vendor/hyper-1.8.1" }
tokio = { path = "__REPO__/vendor/tokio-1.52.3" }
