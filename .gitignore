# Per-crate log dirs written by integration tests (the root /log rule misses these).
novarocks/*/log/
novarocks-server/log/

# Scratch runtimes written by the test harnesses. A successful run removes its
# own contents, but a failed one deliberately retains artifacts for diagnosis.
novarocks-server/.server-binary-smoke-runtime/
/tests/sql/.runtime/

# M07 raw verification artifacts belong in ignored logs/, not Git history.
